":\"concrete-cleaning.html\",\"/services/pressure-surface-cleaning/deck-timber-cleaning/\":\"deck-timber-cleaning.html\",\"/services/pressure-surface-cleaning/driveway-cleaning/\":\"driveway-cleaning.html\",\"/services/pressure-surface-cleaning/exposed-aggregate-cleaning/\":\"exposed-aggregate-cleaning.html\",\"/services/pressure-surface-cleaning/fence-cleaning/\":\"fence-cleaning.html\",\"/services/pressure-surface-cleaning/outdoor-tile-cleaning/\":\"outdoor-tile-cleaning.html\",\"/services/pressure-surface-cleaning/path-hard-surface-cleaning/\":\"path-hard-surface-cleaning.html\",\"/services/pressure-surface-cleaning/paving-patio-cleaning/\":\"paving-patio-cleaning.html\",\"/services/pressure-surface-cleaning/pool-surround-cleaning/\":\"pool-surround-cleaning.html\",\"/services/sealing-surface-protection/\":\"sealing-surface-protection.html\",\"/services/sealing-surface-protection/anti-slip-sealing/\":\"anti-slip-sealing.html\",\"/services/sealing-surface-protection/concrete-colour-sealing/\":\"concrete-colour-sealing.html\",\"/services/sealing-surface-protection/concrete-sealing/\":\"concrete-sealing.html\",\"/services/sealing-surface-protection/driveway-sealing/\":\"driveway-sealing.html\",\"/services/sealing-surface-protection/epoxy-flooring-coatings/\":\"epoxy-flooring-coatings.html\",\"/services/sealing-surface-protection/exposed-aggregate-sealing/\":\"exposed-aggregate-sealing.html\",\"/services/sealing-surface-protection/paver-sealing-re-sanding/\":\"paver-sealing-re-sanding.html\",\"/services/sealing-surface-protection/protective-coatings/\":\"protective-coatings.html\",\"/services/sealing-surface-protection/stone-bluestone-sealing/\":\"stone-bluestone-sealing.html\",\"/services/stain-surface-restoration/\":\"stain-surface-restoration.html\",\"/services/stain-surface-restoration/efflorescence-removal/\":\"efflorescence-removal.html\",\"/services/stain-surface-restoration/gum-removal/\":\"gum-removal.html\",\"/services/stain-surface-restoration/hard-water-mineral-stain-removal/\":\"hard-water-mineral-stain-removal.html\",\"/services/stain-surface-restoration/mortar-cement-residue-removal/\":\"mortar-cement-residue-removal.html\",\"/services/stain-surface-restoration/oil-stain-removal/\":\"oil-stain-removal.html\",\"/services/stain-surface-restoration/paint-overspray-removal/\":\"paint-overspray-removal.html\",\"/services/stain-surface-restoration/rust-stain-removal/\":\"rust-stain-removal.html\",\"/services/windows-gutters-roof-solar/\":\"windows-gutters-roof-solar.html\",\"/services/windows-gutters-roof-solar/awning-pergola-cleaning/\":\"awning-pergola-cleaning.html\",\"/services/windows-gutters-roof-solar/commercial-window-cleaning/\":\"commercial-window-cleaning.html\",\"/services/windows-gutters-roof-solar/glass-balustrade-pool-glass-cleaning/\":\"glass-balustrade-pool-glass-cleaning.html\",\"/services/windows-gutters-roof-solar/gutter-cleaning/\":\"gutter-cleaning.html\",\"/services/windows-gutters-roof-solar/roof-cleaning/\":\"roof-cleaning.html\",\"/services/windows-gutters-roof-solar/solar-panel-cleaning/\":\"solar-panel-cleaning.html\",\"/services/windows-gutters-roof-solar/window-cleaning/\":\"window-cleaning.html\",\"/terms-and-conditions/\":\"terms-and-conditions.html\",\"/thank-you/\":\"thank-you.html\"};\n  /* The anchor keeps its real production href. Nothing is rewritten, so what\n     the markup says and what a browser inspector shows are the production URL,\n     which is what gets imported. The click is intercepted instead, and the\n     mapped flat review file is opened in its place, so local review still\n     works end to end. */\n  document.addEventListener('click', function (ev) {\n    if (ev.defaultPrevented || ev.button !== 0) return;\n    if (ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey) return;\n    var a = ev.target.closest ? ev.target.closest('a[href^=\"/\"]') : null;\n    if (!a) return;\n    if (a.getAttribute('data-route-status') === 'proposed') return;\n    if (a.target && a.target !== '_self') return;\n    var href = a.getAttribute('href') || '';\n    var hash = '';\n    var cut = href.indexOf('#');\n    if (cut > -1) { hash = href.slice(cut); href = href.slice(0, cut); }\n    var target = map[href];\n    if (!target) return;\n    ev.preventDefault();\n    location.href = target + hash;\n  }, true);\n\n  /* 3. success simulation - PREVIEW ONLY, REMOVE BEFORE PUBLICATION.\n     In production the form is submitted natively and the Nifty dashboard is\n     configured to send a successful enquiry to the value in data-success,\n     which is /thank-you/. Nothing here runs on the real domain: the whole\n     block is already gated on the file: protocol and localhost. It exists so\n     that a reviewer who fills the form in and presses Send lands on the Thank\n     You page instead of on a form that posts nowhere. */\n\n  /* V8.2  Multi photo upload. Lists what the visitor attached so they can see\n     the files took, and keeps the file input out of the step validation, which\n     only ever applied to required text controls. */\n  var ups = document.querySelectorAll('input[data-pxfiles]');\n  for (var u = 0; u < ups.length; u++) {\n    (function (inp) {\n      var list = inp.parentNode.querySelector('[data-pxfilelist]');\n      var btn  = inp.parentNode.querySelector('.pe-up__t');\n      inp.addEventListener('change', function () {\n        if (!list) return;\n        list.innerHTML = '';\n        var f = inp.files || [];\n        for (var i = 0; i < f.length; i++) {\n          var li = document.createElement('li');\n          var kb = f[i].size / 1024;\n          li.textContent = f[i].name + ' (' +\n            (kb > 1024 ? (kb / 1024).toFixed(1) + ' MB' : Math.round(kb) + ' KB') + ')';\n          list.appendChild(li);\n        }\n        if (btn) {\n          btn.textContent = f.length\n            ? (f.length === 1 ? 'Change photo' : 'Add or change photos')\n            : 'Choose photos';\n        }\n      });\n    }(ups[u]));\n  }\n\n  var forms = document.querySelectorAll('form[data-pxform]');\n  for (var k = 0; k < forms.length; k++) {\n    forms[k].addEventListener('submit', function (ev) {\n      ev.preventDefault();                       // preview only, see above\n      var to = this.getAttribute('data-success') || '/thank-you/';\n      window.location.href = map[to] || to;\n    });\n  }\n})();\n\n/* V10.0 home page only. Two small enhancements that layer on top of site.js.\n   Neither is load bearing: with this file absent the panel still opens and the\n   starting price picker still switches, because the picker is a radio group\n   switched in CSS. */\n(function () {\n  'use strict';\n\n  /* 1. carry the chosen surface into the quote drawer, so the person does not\n        answer the same question twice. */\n  var sel = document.getElementById('pe-q-service');\n  Array.prototype.forEach.call(\n    document.querySelectorAll('[data-quote-service]'), function (t) {\n      t.addEventListener('click', function () {\n        if (!sel) return;\n        var want = t.getAttribute('data-quote-service');\n        for (var i = 0; i < sel.options.length; i++) {\n          if (sel.options[i].text === want) { sel.selectedIndex = i; break; }\n        }\n      });\n    });\n\n  /* 2. count the figure up when a surface is chosen. Decorative only: the\n        resting markup already carries the correct number. */\n  var reduce = window.matchMedia &&\n               window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n  if (reduce) return;\n\n  function countUp(el) {\n    var target = parseInt(String(el.textContent).replace(/[^0-9]/g, ''), 10);\n    if (!target) return;\n    var t0 = null, dur = 520;\n    function step(now) {\n      if (t0 === null) t0 = now;\n      var k = Math.min((now - t0) / dur, 1);\n      k = 1 - Math.pow(1 - k, 3);\n      el.textContent = '$' + Math.round(target * k);\n      if (k < 1) requestAnimationFrame(step);\n      else el.textContent = '$' + target;\n    }\n    requestAnimationFrame(step);\n  }\n\n  Array.prototype.forEach.call(\n    document.querySelectorAll('.px-est__r'), function (r) {\n      r.addEventListener('change', function () {\n        if (!r.checked) return;\n        var pane = document.querySelector(\n          '.px-est__pane--' + r.id.replace('px-est-', ''));\n        var num = pane && pane.querySelector('.px-est__num');\n        if (num) countUp(num);\n      });\n    });\n})();\n</script>\n"
}
