  "footer": "<script>\n/* Prime Exteriors shared behaviour. The locked design reference is home-v7.html.\n   Nothing here submits a form: Nifty handles submission on import (V8.0 s3.13). */\n\n/* ---- before and after sliders (only runs where .px-ba exists) ---- */\n/* before and after sliders: each range drives --pos on its own card */\n  (function(){\n    \"use strict\";\n    var cards = document.querySelectorAll('.px-ba');\n    Array.prototype.forEach.call(cards, function(card){\n      var r = card.querySelector('.px-ba__range');\n      if(!r){ return; }\n      function paint(){ card.style.setProperty('--pos', r.value + '%'); }\n      function grab(){ card.classList.add('is-drag'); }\n      function drop(){ card.classList.remove('is-drag'); }\n      r.addEventListener('input', paint);\n      r.addEventListener('pointerdown', grab);\n      r.addEventListener('pointerup', drop);\n      r.addEventListener('pointercancel', drop);\n      r.addEventListener('blur', drop);\n      window.addEventListener('pointerup', drop);\n\n      /* a fine step keeps the drag smooth, so give the arrow keys a usable one */\n      r.addEventListener('keydown', function(e){\n        var lo = parseFloat(r.min), hi = parseFloat(r.max), v = parseFloat(r.value), step = 5;\n        if(e.key === 'ArrowRight' || e.key === 'ArrowUp'){ v += step; }\n        else if(e.key === 'ArrowLeft' || e.key === 'ArrowDown'){ v -= step; }\n        else if(e.key === 'PageUp'){ v += step * 3; }\n        else if(e.key === 'PageDown'){ v -= step * 3; }\n        else if(e.key === 'Home'){ v = lo; }\n        else if(e.key === 'End'){ v = hi; }\n        else { return; }\n        e.preventDefault();\n        drop();\n        r.value = Math.min(hi, Math.max(lo, v));\n        paint();\n      });\n      paint();\n    });\n  })();\n\n/* ---- global shell: nav, mega menu, quote widget, reveal, back to top ---- */\n(function(){\n  \"use strict\";\n  /* ---- navigation ------------------------------------------------------- */\n  var burger=document.querySelector('.pe-burger'),nav=document.getElementById('pe-nav');\n  if(burger&&nav){burger.addEventListener('click',function(){\n    var open=nav.classList.toggle('is-open');\n    burger.setAttribute('aria-expanded',open?'true':'false');\n    burger.setAttribute('aria-label',open?'Close menu':'Open menu');\n    if(!open){Array.prototype.forEach.call(nav.querySelectorAll('.pe-nav__btn[aria-expanded=\"true\"]'),\n      function(b){b.setAttribute('aria-expanded','false');});}\n  });}\n  Array.prototype.forEach.call(document.querySelectorAll('.pe-nav__btn'),function(btn){\n    btn.addEventListener('click',function(e){\n      e.stopPropagation();\n      var open=btn.getAttribute('aria-expanded')==='true';\n      Array.prototype.forEach.call(document.querySelectorAll('.pe-nav__btn'),function(o){\n        if(o!==btn)o.setAttribute('aria-expanded','false');});\n      btn.setAttribute('aria-expanded',open?'false':'true');\n    });\n  });\n  document.addEventListener('click',function(e){\n    if(!e.target.closest('.pe-nav__item')){\n      Array.prototype.forEach.call(document.querySelectorAll('.pe-nav__btn'),\n        function(o){o.setAttribute('aria-expanded','false');});}\n  });\n  document.addEventListener('keydown',function(e){\n    if(e.key==='Escape'){\n      Array.prototype.forEach.call(document.querySelectorAll('.pe-nav__btn'),\n        function(o){o.setAttribute('aria-expanded','false');});\n      if(nav&&nav.classList.contains('is-open')){nav.classList.remove('is-open');\n        burger.setAttribute('aria-expanded','false');burger.focus();}}\n  });\n\n  /* ---- the standard three step enquiry form ------------------------------\n     One engine for every .pe-qform on the page: the floating panel, the page\n     panel on Get a Quote and Contact, and the inline quote section.\n\n     Every visible field is mandatory. The engine manages steps, focus and\n     validation state only. It never calls preventDefault on a valid\n     submission, never uses fetch or XHR, and sets no custom submit logic, so\n     the final submission stays native and Nifty compatible.\n\n     Controls in a step the visitor has not reached yet are disabled, so a\n     hidden required field can never block the browser's own validation. They\n     are enabled as each step is reached, which means that by the time the\n     Send button is visible every control is enabled and carries its value\n     into the native submission.\n  ------------------------------------------------------------------------- */\n  var AU = /^(?:0[23478]\\d{8}|13\\d{4}|1[38]00\\d{6})$/;\n\n  function plausibleAU(raw){\n    var v = String(raw || '').replace(/[\\s().\\-‐-―]/g, '');\n    if (v.indexOf('+61') === 0) v = '0' + v.slice(3);\n    else if (v.indexOf('0061') === 0) v = '0' + v.slice(4);\n    else if (v.indexOf('61') === 0 && v.length === 11) v = '0' + v.slice(2);\n    return AU.test(v);\n  }\n\n  function controls(scope){\n    return scope.querySelectorAll('input,select,textarea');\n  }\n\n  /* ---- V7 inline validation messages -----------------------------------\n     The message is written under the control rather than left to the browser's\n     own bubble, so it stays on screen while the field is being fixed and every\n     form behaves the same way. The rules and the wording are V7's. The phone\n     rule is the Australian one rather than V7's digit count, because it has to\n     accept 0400 638 010, 0400638010, +61 400 638 010 and (03) 1234 5678 and\n     reject text, which a length check does not do.\n\n     setCustomValidity is still set alongside the message. That keeps the same\n     rule inside native constraint validation, so the browser refuses a bad\n     submission on its own and the final submit stays native. */\n  var WARN = '<svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\">'\n           + '<path d=\"M12 2 1 21h22L12 2zm0 6 1 7h-2l1-7zm0 10a1.3 1.3 0 110 2.6 '\n           + '1.3 1.3 0 010-2.6z\"/></svg>';\n\n  function fieldName(el){\n    var l = el.id ? document.querySelector('label[for=\"' + el.id + '\"]') : null;\n    if (!l && el.type === 'radio'){\n      var g = el.closest('.pe-field');\n      l = g ? g.querySelector('.pe-qlabel') : null;\n    }\n    var t = l ? l.textContent.replace('*', '').trim() : (el.name || 'This field');\n    return t.charAt(0).toUpperCase() + t.slice(1);\n  }\n\n  function message(el){\n    var name = fieldName(el), v = String(el.value || '').trim();\n    if (el.type === 'radio'){\n      return (el.form && el.form.querySelector('input[name=\"' + el.name + '\"]:checked'))\n             ? '' : 'Choose a ' + name.toLowerCase() + '.';\n    }\n    if (!v) return el.tagName === 'SELECT'\n             ? 'Choose a ' + name.toLowerCase() + '.'\n             : name + ' is required.';\n    if (el.type === 'email'){\n      return /^[^\\s@]+@[^\\s@]+\\.[a-z]{2,}$/i.test(v) ? ''\n           : 'Enter a valid email address, like name@example.com.';\n    }\n    if (el.hasAttribute('data-au-phone') || el.type === 'tel'){\n      return plausibleAU(v) ? ''\n           : 'Enter a valid phone number, like 0400 638 010.';\n    }\n    if (el.tagName === 'TEXTAREA' && v.length < 10){\n      return 'Please add a little more detail, at least a few words.';\n    }\n    if (v.length < 2) return name + ' looks too short.';\n    return '';\n  }\n\n  /* the message belongs in the control's own wrapper: a row holds two controls\n     side by side, so writing into the shared row lets the second field\n     overwrite the first one's message */\n  function holderOf(el){\n    var field = el.closest('.px-field') || el.closest('.pe-field');\n    if (!field) return el.parentNode;\n    if (el.type === 'radio') return field;\n    var node = el;\n    while (node.parentNode && node.parentNode !== field) node = node.parentNode;\n    return (node && node !== el && node.nodeType === 1) ? node : field;\n  }\n\n  function slot(el){\n    var holder = holderOf(el);\n    var msg = holder.querySelector('.fv-msg');\n    if (!msg){\n      msg = document.createElement('p');\n      msg.className = 'fv-msg';\n      msg.id = 'fv-' + (el.id || el.name || 'f') + '-msg';\n      holder.appendChild(msg);\n    }\n    return msg;\n  }\n\n  function guard(el){\n    if (el.type === 'hidden') return '';\n    var err = message(el);\n    if (el.setCustomValidity) el.setCustomValidity(err);\n    return err;\n  }\n\n  /* show is false while typing before the field has ever been flagged, so a\n     message never appears until the visitor has tried to move on */\n  function mark(el, bad, show){\n    if (el.type === 'hidden') return;\n    var box = el.type === 'radio' ? (el.closest('.pe-qchips') || el) : el,\n        msg = slot(el),\n        err = bad ? message(el) : '';\n    if (err && show !== false){\n      box.classList.add('is-bad', 'fv-bad');\n      box.classList.remove('fv-ok');\n      el.setAttribute('aria-invalid', 'true');\n      el.setAttribute('aria-describedby', msg.id);\n      msg.innerHTML = WARN + '<span>' + err + '</span>';\n      msg.classList.add('fv-show');\n    } else {\n      box.classList.remove('is-bad', 'fv-bad');\n      if (String(el.value || '').trim() !== '') box.classList.add('fv-ok');\n      el.removeAttribute('aria-invalid');\n      el.removeAttribute('aria-describedby');\n      msg.classList.remove('fv-show');\n      msg.innerHTML = '';\n    }\n  }\n\n  function setupForm(form){\n    var steps = form.querySelectorAll('.pe-qstep'),\n        wrap  = form.parentNode,\n        dots  = wrap ? wrap.querySelectorAll('.pe-qsteps li') : [],\n        back  = form.querySelector('.pe-qback'),\n        next  = form.querySelector('.pe-qnext'),\n        send  = form.querySelector('.pe-qsend'),\n        cur   = 0;\n    if (!steps.length) return null;\n\n    function paint(){\n      for (var i = 0; i < steps.length; i++){\n        steps[i].hidden = (i !== cur);\n        steps[i].classList.toggle('is-on', i === cur);\n        // a step the visitor has not reached is disabled, so its required\n        // fields cannot block a submission they have not seen\n        var c = controls(steps[i]);\n        for (var k = 0; k < c.length; k++) c[k].disabled = (i > cur);\n      }\n      for (var j = 0; j < dots.length; j++){\n        dots[j].classList.toggle('is-on', j === cur);\n        dots[j].classList.toggle('is-done', j < cur);\n      }\n      if (back) back.hidden = (cur === 0);\n      if (next) next.hidden = (cur === steps.length - 1);\n      if (send) send.hidden = (cur !== steps.length - 1);\n    }\n\n    function validate(i, focus){\n      var c = controls(steps[i]), ok = true, first = null;\n      for (var k = 0; k < c.length; k++){\n        if (c[k].disabled || c[k].type === 'hidden') continue;\n        var err = guard(c[k]);\n        if (!err){ mark(c[k], false); continue; }\n        mark(c[k], true, true); ok = false;\n        if (!first) first = c[k];\n      }\n      // the message is on the page, so the field only needs focus. No\n      // reportValidity: that would raise the browser bubble on top of it.\n      if (!ok && focus && first) first.focus();\n      return ok;\n    }\n\n    function go(i){ cur = Math.max(0, Math.min(steps.length - 1, i)); paint(); }\n\n    Array.prototype.forEach.call(controls(form), function(el){\n      var ev = (el.tagName === 'SELECT' || el.type === 'radio') ? 'change' : 'input';\n      // once a field has been flagged its message clears as soon as it is fixed\n      el.addEventListener(ev, function(){\n        var err = guard(el);\n        var box = el.type === 'radio' ? (el.closest('.pe-qchips') || el) : el;\n        mark(el, !!err, box.classList.contains('fv-bad'));\n      });\n      el.addEventListener('blur', function(){ guard(el); }, true);\n    });\n\n    if (next) next.addEventListener('click', function(){\n      if (validate(cur, true)) go(cur + 1);\n    });\n    if (back) back.addEventListener('click', function(){ go(cur - 1); });\n\n    // The last line of defence. If an earlier step has somehow gone invalid,\n    // show it rather than letting the browser fail on a field nobody can see.\n    // A valid form is not touched here, so its submission stays native.\n    if (send) send.addEventListener('click', function(ev){\n      for (var i = 0; i < steps.length; i++){\n        if (!validate(i, false)){\n          ev.preventDefault(); go(i); validate(i, true); return;\n        }\n      }\n    });\n\n    paint();\n    return { form: form, go: go, validate: validate, steps: steps };\n  }\n\n  var FORMS = [];\n  Array.prototype.forEach.call(document.querySelectorAll('.pe-qform'), function(f){\n    var api = setupForm(f);\n    if (api) FORMS.push(api);\n  });\n  window.__pxForms = FORMS;\n\n  /* ---- floating quote panel ---------------------------------------------- */\n  var panel = document.getElementById('pe-quote-panel'),\n      scrim = document.querySelector('.pe-qscrim'),\n      qtab  = document.querySelector('.pe-qtab'),\n      lastFocus = null;\n\n  function openPanel(){\n    if (!panel) return;\n    lastFocus = document.activeElement;\n    panel.hidden = false; scrim.hidden = false;\n    document.body.classList.add('pe-locked');\n    requestAnimationFrame(function(){\n      panel.classList.add('is-open'); scrim.classList.add('is-open');\n    });\n    if (qtab) qtab.setAttribute('aria-expanded', 'true');\n    var first = panel.querySelector('input:not([disabled]),select:not([disabled]),textarea:not([disabled]),button');\n    if (first) setTimeout(function(){ first.focus(); }, 280);\n  }\n  function closePanel(){\n    if (!panel || panel.hidden) return;\n    panel.classList.remove('is-open'); scrim.classList.remove('is-open');\n    document.body.classList.remove('pe-locked');\n    if (qtab) qtab.setAttribute('aria-expanded', 'false');\n    setTimeout(function(){ panel.hidden = true; scrim.hidden = true; }, 260);\n    if (lastFocus && lastFocus.focus) lastFocus.focus();\n  }\n  Array.prototype.forEach.call(document.querySelectorAll('[data-quote-open]'), function(t){\n    t.addEventListener('click', function(ev){ ev.preventDefault(); openPanel(); });\n  });\n  Array.prototype.forEach.call(document.querySelectorAll('[data-quote-close]'), function(t){\n    t.addEventListener('click', closePanel);\n  });\n  if (panel){\n    panel.addEventListener('keydown', function(ev){\n      if (ev.key === 'Escape'){ closePanel(); return; }\n      if (ev.key !== 'Tab') return;\n      var f = panel.querySelectorAll('a[href],button:not([hidden]),input:not([hidden]):not([disabled]),select:not([disabled]),textarea:not([disabled])');\n      var vis = []; for (var i = 0; i < f.length; i++){ if (f[i].offsetParent !== null) vis.push(f[i]); }\n      if (!vis.length) return;\n      var first = vis[0], last = vis[vis.length - 1];\n      if (ev.shiftKey && document.activeElement === first){ ev.preventDefault(); last.focus(); }\n      else if (!ev.shiftKey && document.activeElement === last){ ev.preventDefault(); first.focus(); }\n    });\n  }\n\n  /* ---- back to top ------------------------------------------------------- */\n  var top=document.querySelector('.pe-top');\n  if(top){\n    top.addEventListener('click',function(){\n      var reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n      window.scrollTo({top:0,behavior:reduce?'auto':'smooth'});});\n    var tick=false;\n    window.addEventListener('scroll',function(){\n      if(tick)return;tick=true;\n      window.requestAnimationFrame(function(){\n        top.classList.toggle('is-on',window.pageYOffset>700);tick=false;});\n    },{passive:true});\n  }\n})();\n\n\n/* --------------------------------------------------------------------------\n   Comparison table scroll affordance.\n\n   The table scrolls sideways below 720px. This only tells the visitor so: it\n   adds is-over while something is hidden and is-end once they have reached the\n   right, and the stylesheet draws the edge fade and the hint from those. It\n   reads layout and sets classes, nothing else.\n   ------------------------------------------------------------------------- */\n(function(){\n  var boxes = document.querySelectorAll('.px-cmp');\n  if (!boxes.length) return;\n\n  function sync(cmp){\n    var w = cmp.querySelector('.px-cmp__wrap');\n    if (!w) return;\n    var hidden = w.scrollWidth - w.clientWidth;\n    cmp.classList.toggle('is-over', hidden > 4);\n    cmp.classList.toggle('is-end', w.scrollLeft >= hidden - 4);\n  }\n\n  Array.prototype.forEach.call(boxes, function(cmp){\n    var w = cmp.querySelector('.px-cmp__wrap');\n    if (!w) return;\n    sync(cmp);\n    var tick = false;\n    w.addEventListener('scroll', function(){\n      if (tick) return;\n      tick = true;\n      window.requestAnimationFrame(function(){ sync(cmp); tick = false; });\n    }, {passive:true});\n  });\n\n  var rt;\n  window.addEventListener('resize', function(){\n    clearTimeout(rt);\n    rt = setTimeout(function(){\n      Array.prototype.forEach.call(boxes, sync);\n    }, 120);\n  }, {passive:true});\n})();\n\n\n/* ==========================================================================\n   PREVIEW BOOTSTRAP - REMOVE BEFORE PUBLICATION\n   V8.0 s23.9. Two jobs, both local-review only, both inert on the real domain:\n   1. link resolver - leaves every href exactly as delivered and intercepts the\n      click instead, opening the flat review file the route map names, so\n      navigation works end to end during review while an inspector still shows\n      the production URL. It ignores forms, tel:, mailto:, #fragments, external\n      links, new-tab clicks and modified clicks, and does nothing at all when a\n      route has no file.\n   2. success simulation - navigates to the page a form declares in\n      data-success, so the thank you route can be walked during review. The\n      real submission is wired by the dashboard on import.\n   Delivered source is untouched either way: both run at runtime.\n\n   The image path fallback that used to live here is gone: every image is now\n   embedded in its page, so there is no path left to resolve.\n   ========================================================================== */\n(function(){\n  \"use strict\";\n  var h = location.hostname, p = location.protocol;\n  var isFile  = (p === 'file:');\n  var isLocal = (h === 'localhost' || h === '127.0.0.1' || h === '0.0.0.0' || h === '::1' || h === '');\n  if (!isFile && !isLocal) return;\n\n  var map = {\"/\":\"index.html\",\"/about/\":\"about.html\",\"/commercial/\":\"commercial.html\",\"/commercial/body-corporate-strata/\":\"body-corporate-strata.html\",\"/commercial/builders-developers/\":\"builders-developers.html\",\"/commercial/car-parks-hardstands/\":\"car-parks-hardstands.html\",\"/commercial/commercial-building-washing/\":\"commercial-building-washing.html\",\"/commercial/factory-industrial/\":\"factory-industrial.html\",\"/commercial/medical-aged-care/\":\"medical-aged-care.html\",\"/commercial/real-estate-property-managers/\":\"real-estate-property-managers.html\",\"/commercial/retail-hospitality/\":\"retail-hospitality.html\",\"/commercial/scheduled-exterior-maintenance/\":\"scheduled-exterior-maintenance.html\",\"/commercial/schools-childcare/\":\"schools-childcare.html\",\"/commercial/sign-cleaning/\":\"sign-cleaning.html\",\"/commercial/tennis-court-sports-surface-cleaning/\":\"tennis-court-sports-surface-cleaning.html\",\"/commercial/warehouses-factories/\":\"warehouses-factories.html\",\"/contact/\":\"contact.html\",\"/locations/\":\"locations.html\",\"/locations/vic/\":\"vic.html\",\"/locations/vic/exterior-cleaning-banyule/\":\"exterior-cleaning-banyule.html\",\"/locations/vic/exterior-cleaning-boroondara/\":\"exterior-cleaning-boroondara.html\",\"/locations/vic/exterior-cleaning-brimbank/\":\"exterior-cleaning-brimbank.html\",\"/locations/vic/exterior-cleaning-darebin/\":\"exterior-cleaning-darebin.html\",\"/locations/vic/exterior-cleaning-hobsons-bay/\":\"exterior-cleaning-hobsons-bay.html\",\"/locations/vic/exte